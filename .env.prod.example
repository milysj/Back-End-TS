# --- CONFIGURAÇÕES DO SERVIDOR (PROD) ---
PORT=5000
NODE_ENV=production
APP_ENV=prod
TRUST_PROXY=1

# --- BANCO DE DADOS (MongoDB) ---
MONGO_URI=mongodb://localhost:27017/estudemy_prod

# --- SEGURANÇA E AUTENTICAÇÃO ---
JWT_SECRET=seu_segredo_jwt_de_producao_aqui
JWT_EXPIRES=1d
TWO_FACTOR_PENDING_EXPIRES=5m
TWO_FACTOR_ISSUER=EstudeMy
APP_NAME=EstudeMy

# --- INTEGRAÇÃO COM GEMINI (IA) ---
GEMINI_API_KEY=sua_chave_gemini_prod_aqui
GEMINI_MODEL=gemini-flash-latest
TRILHA_IA_API_URL=

# --- CONFIGURAÇÕES DE EMAIL (SMTP / Resend) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@estudemy.com
MAIL_REPLY_TO=suporte@estudemy.com

# --- INTEGRAÇÃO RESEND (Opcional se SMTP for usado) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- REDIRECIONAMENTOS FRONTEND ---
FRONTEND_URL=https://estudemy.com
BACKEND_URL=https://api.estudemy.com
PASSWORD_RESET_FRONTEND_PATH=/recuperar-senha
FRONTEND_EMAIL_VERIFIED_REDIRECT_PATH=/login?email_verificado=true

# --- MONITORAMENTO DE LOGS (Better Stack) ---
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_URL=
BETTER_STACK_SERVICE_NAME=estudemy-backend-prod

# --- LIMITES DE REQUISIÇÕES (RATE LIMIT) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_2FA_VERIFY_MAX=10
