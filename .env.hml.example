# --- CONFIGURAÇÕES DO SERVIDOR (HML) ---
PORT=5000
NODE_ENV=production
APP_ENV=hml
TRUST_PROXY=1

# --- BANCO DE DADOS (MongoDB) ---
MONGO_URI=mongodb://localhost:27017/estudemy_hml

# --- SEGURANÇA E AUTENTICAÇÃO ---
JWT_SECRET=seu_segredo_jwt_de_homologacao_aqui
JWT_EXPIRES=1d
TWO_FACTOR_PENDING_EXPIRES=5m
TWO_FACTOR_ISSUER=EstudeMy-HML
APP_NAME=EstudeMy-HML

# --- INTEGRAÇÃO COM GEMINI (IA) ---
GEMINI_API_KEY=sua_chave_gemini_hml_aqui
GEMINI_MODEL=gemini-flash-latest
TRILHA_IA_API_URL=

# --- CONFIGURAÇÕES DE EMAIL (SMTP / Resend) ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=seu_usuario_smtp
MAIL_PASS=sua_senha_smtp
MAIL_FROM=no-reply@hml.estudemy.com
MAIL_REPLY_TO=suporte@hml.estudemy.com

# --- INTEGRAÇÃO RESEND (Opcional se SMTP for usado) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- REDIRECIONAMENTOS FRONTEND ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PASSWORD_RESET_FRONTEND_PATH=/recuperar-senha
FRONTEND_EMAIL_VERIFIED_REDIRECT_PATH=/login?email_verificado=true

# --- MONITORAMENTO DE LOGS (Better Stack) ---
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_URL=
BETTER_STACK_SERVICE_NAME=estudemy-backend-hml

# --- LIMITES DE REQUISIÇÕES (RATE LIMIT) ---
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_2FA_VERIFY_MAX=15
